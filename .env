# Flask configuration
SECRET_KEY=your-super-secret-key-change-this-in-production
FLASK_ENV=development
DEBUG=True
HOST=0.0.0.0
PORT=5000

# Scraping settings
SCRAPING_MAX_PAGES=10
SCRAPING_DELAY=2
SCRAPING_TIMEOUT=30

# Chrome driver path (leave empty for auto-detection)
CHROME_DRIVER_PATH=

# File storage limits (in MB)
MAX_FILE_SIZE=16

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Cleanup settings (days)
CLEANUP_DAYS=7
